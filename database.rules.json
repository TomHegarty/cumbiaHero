{
  "rules": {
    ".read": false,
    ".write": false,
    "lobbies": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('hostUid').val() === auth.uid",
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{6}$/) && newData.hasChildren(['hostUid', 'createdAt', 'expiresAt', 'version', 'status'])",
        "hostUid": { ".validate": "newData.isString()" },
        "guestUid": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && data.parent().child('status').val() === 'waiting' && data.parent().child('expiresAt').val() > now"
        },
        "createdAt": { ".validate": "newData.isNumber()" },
        "expiresAt": { ".validate": "newData.isNumber() && newData.val() <= now + 10800000" },
        "version": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "status": {
          ".write": "auth != null && auth.uid === data.parent().child('hostUid').val()",
          ".validate": "newData.isString() && newData.val().matches(/^(waiting|playing|done)$/)"
        },
        "battle": {
          ".write": "auth != null && auth.uid === data.parent().child('hostUid').val()",
          "round": { ".validate": "newData.isNumber()" },
          "startAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (auth.uid === data.parent().parent().child('hostUid').val() || auth.uid === data.parent().parent().child('guestUid').val()) && data.parent().parent().child('expiresAt').val() > now",
            "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "role": { ".validate": "newData.val() === 'host' || newData.val() === 'guest'" },
            "setList": { "$i": { ".validate": "newData.isString() && newData.val().length <= 64" } },
            "ready": { ".validate": "newData.isBoolean()" },
            "connected": { ".validate": "newData.isBoolean()" },
            "left": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "rounds": {
          ".write": "auth != null && auth.uid === data.parent().child('hostUid').val()",
          "$n": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && (auth.uid === data.parent().parent().parent().child('hostUid').val() || auth.uid === data.parent().parent().parent().child('guestUid').val())",
              "hits": {
                "$hit": {
                  ".validate": "newData.hasChildren(['i', 'g']) && newData.child('i').isNumber() && newData.child('g').isString() && newData.child('g').val().matches(/^[pgm]$/)"
                }
              },
              "result": { ".validate": "newData.hasChildren(['dealt', 'notes']) && newData.child('dealt').isNumber() && newData.child('notes').isNumber()" },
              "$other": { ".validate": false }
            }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
